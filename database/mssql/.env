# Configure SQL Server settings with environment variables on Linux
# https://learn.microsoft.com/en-us/sql/linux/configure/environment-variables?view=sql-server-ver17 

# Required by Microsoft SQL Server container startup
ACCEPT_EULA=Y

DB_HOST_NAME=mssqldbsrv1
MSSQL_TCP_PORT=1433

# Valid MSSQL_PID options for SQL Server: 
# - Developer (Enterprise Developer features, non-prod)
# - StandardDeveloper (Standard Edition feature-set, non-prod)
# - Other options available: Express, Standard, Enterprise, Evaluation, or a 25-digit product key
MSSQL_PID=Developer

WEB_UI_1_PORT=8090
DB_FOLDER=./dbdata

# The following variables are used by './create_test_db.sh' to set up a custom database and a standard user account.
MSSQL_DB=MyTestDB
MSSQL_USER=MyTestUser

# For security reasons, never hardcode passwords directly in this file. 
# Instead, load them from environment variables defined in either 
# your user profile (~/.bashrc) or system-wide (/etc/environment).
MSSQL_PASSWORD=${USER_SECRET_KEY}

# 'sa' user ID is defined for initial configuration and/or during development. It should be disabled for production environments.
MSSQL_SA_PASSWORD=${ADMIN_SECRET_KEY}


# To set the environment variables, uncomment and execute the following commands in your terminal:
# # Append the variables to your ~/.bashrc file
# echo 'export ADMIN_SECRET_KEY="***"' >> ~/.bashrc
# echo 'export USER_SECRET_KEY="***"' >> ~/.bashrc
# # Reload ~/.bashrc to apply changes immediately to the current session
# source ~/.bashrc
# # Verification
# echo "ADMIN_SECRET_KEY=$ADMIN_SECRET_KEY"
# echo "USER_SECRET_KEY=$USER_SECRET_KEY"