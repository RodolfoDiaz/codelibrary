# Configure SQL Server settings with environment variables on Linux
# https://learn.microsoft.com/en-us/sql/linux/configure/environment-variables?view=sql-server-ver17 
DB_HOST_NAME=mssqldbsrv1
MSSQL_TCP_PORT=1433
ACCEPT_EULA=Y
#MSSQL_SA_PASSWORD=   # Get this password from an environment variable, for example at: ~/.bashrc -OR- /etc/environment
MSSQL_PID=StandardDeveloper
WEB_UI_1_PORT=38080
DB_FOLDER=./dbdata
MSSQL_DB=MyTestDB
MSSQL_USER=MyTestUser
#MSSQL_PASSWORD=   # Get this password from an environment variable, for example at: ~/.bashrc -OR- /etc/environment